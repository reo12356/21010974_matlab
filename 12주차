clear; clc;

% (a), (b)
varNames = {'Class', 'Alcohol', 'MalicAcid', 'Ash', 'Alcalinity', 'Magnesium', ...
            'Phenols', 'Flavanoids', 'Nonflavanoid', 'Proanthocyanins', ...
            'ColorIntensity', 'Hue', 'OD280', 'Proline'};
Wine = readtable('wine.data', 'FileType', 'text');
Wine.Properties.VariableNames = varNames;

% (c)
X = [Wine.Alcohol, Wine.MalicAcid, Wine.ColorIntensity];

% (d) 
mu_X = mean(X, 1);
sigma_X = std(X, 0, 1);
X_std = (X - mu_X) ./ sigma_X;

% (e)
normVec = sqrt(sum(X_std.^2, 2));

% (f)
cutoff = prctile(normVec, 90);

% (g)
T_top = Wine(normVec >= cutoff, :);

% (h)
disp(T_top(:, {'Class', 'Alcohol', 'MalicAcid', 'ColorIntensity'}));
