clear; clc;

% (a)
x = -5:0.05:5;
y = -5:0.05:5;
[X, Y] = meshgrid(x, y);

% (b)
Z = exp(-0.08 * (X.^2 + Y.^2)) .* sin(3 * X) .* cos(2 * Y) + 0.15 * sin(X .* Y);

% (c)
figure;
h_surf = surf(X, Y, Z); 
hold on;

% (d)
shading interp;
colorbar;

% (e)
xlabel('x-axis'); 
ylabel('y-axis'); 
zlabel('z=f(x,y)');

% (f)
title('Detailed Surface Plot of a Multivariable Function');

% (g)
grid on;
ax = gca;
ax.FontSize = 12;

% (h)
view(45, 30);

% (i)
Z0 = zeros(size(Z));
h_plane = surf(X, Y, Z0, 'FaceColor', [0.5 0.5 0.5], 'FaceAlpha', 0.4, 'EdgeColor', 'none');

% (j)
[maxZ, maxIdx] = max(Z(:));
[minZ, minIdx] = min(Z(:));

% (k)
[rowMax, colMax] = ind2sub(size(Z), maxIdx);
[rowMin, colMin] = ind2sub(size(Z), minIdx);
maxPoint = [X(rowMax, colMax), Y(rowMax, colMax), maxZ];
minPoint = [X(rowMin, colMin), Y(rowMin, colMin), minZ];

% (l)
h_max = plot3(maxPoint(1), maxPoint(2), maxPoint(3), 'ro', 'MarkerSize', 10, 'MarkerFaceColor', 'r');
h_min = plot3(minPoint(1), minPoint(2), minPoint(3), 'b^', 'MarkerSize', 10, 'MarkerFaceColor', 'b');
legend([h_surf, h_plane, h_max, h_min], ...
       {'Surface', 'z=0 plane', 'Maximum point', 'Minimum point'}, ...
       'Location', 'best');
hold off;

% (m)
saveas(gcf, 'complex_surface.png');

