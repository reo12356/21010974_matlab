function out = squareVec(v)
    out = v.^2;
end

function m = meanVec(v)
    m = mean(v);
end

function out = mixedTransform(v)
    out = zeros(size(v));
    for i = 1:length(v)
        if v(i) < 0
            out(i) = abs(v(i));
        elseif v(i) == 0
            out(i) = 0;        
        else 
            out(i) = 2 * v(i) + 1;
        end
    end
end


