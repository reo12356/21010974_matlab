clear; clc;

total_products = 50000;

%(a)
passed_step1 = rand(total_products, 1) <= 0.94;

%(b)
passed_step2 = false(total_products, 1);
idx_step1 = find(passed_step1);
passed_step2(idx_step1) = rand(length(idx_step1), 1) <= 0.91;

%(c)
passed_step3 = false(total_products, 1);
idx_step2 = find(passed_step2);
passed_step3(idx_step2) = rand(length(idx_step2), 1) <= 0.88;

%(d)
final_pass_rate = mean(passed_step3);

fail_at_step1 = total_products - sum(passed_step1);
fail_at_step2 = sum(passed_step1) - sum(passed_step2);
fail_at_step3 = sum(passed_step2) - sum(passed_step3);
final_passed = sum(passed_step3);

fprintf('최종 공정 합격률: %.2f%%\n\n', final_pass_rate * 100);

%(e)
categories = {'1단계 탈락', '2단계 탈락', '3단계 탈락', '최종 합격'};
counts = [fail_at_step1, fail_at_step2, fail_at_step3, final_passed];

figure(10);
bar(counts, 'FaceColor', [0.2 0.6 0.4]);
set(gca, 'XTickLabel', categories);
grid on; 
