clear; clc;

%(a)
days = 365;
lambda_order = 180;
daily_orders = poissrnd(lambda_order, days, 1);

%(b)
daily_total_time = zeros(days, 1);

for d = 1:days
    num_orders = daily_orders(d);
    if num_orders > 0
        order_times = 6 + 2 * randn(num_orders, 1);
        order_times(order_times < 0) = 0;
        daily_total_time(d) = sum(order_times);
    else
        daily_total_time(d) = 0;
    end
end

%(c)
over_1200_ratio = mean(daily_total_time > 1200)*100

%(d)
figure(4);
subplot(2,1,1);
plot(1:days, daily_orders, 'Color', 'b', 'LineWidth', 1.5);
grid on; box on;
ylabel('주문 수 (건)');
title('365일간의 일별 주문 수 추이 (4번)');

subplot(2,1,2);
plot(1:days, daily_total_time, 'Color', 'm', 'LineWidth', 1.5);
grid on; box on;
xlabel('날짜 (일)');
ylabel('총 처리 시간 (분)');
title('365일간의 일별 총 처리 시간 추이 (4번)');

%(e)
figure(5);
scatter(daily_orders, daily_total_time, 'filled', 'MarkerFaceColor', 'b');
grid on;
