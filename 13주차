clear; clc;

%(a)
num_paths = 5000;
days = 60;
returns = 0.0008 + 0.015 * randn(num_paths, days);

%(b)
initial_asset = 100;
asset_paths = initial_asset * cumprod(1 + returns, 2);
asset_paths = [ones(num_paths, 1) * initial_asset, asset_paths];

%(c)
final_assets = asset_paths(:, end);
mean_final = mean(final_assets);
min_final = min(final_assets);
max_final = max(final_assets);

fprintf('6번 결과:\n');
fprintf('마지막 날 자산가치 평균: %.2f\n', mean_final);
fprintf('마지막 날 자산가치 최솟값: %.2f\n', min_final);
fprintf('마지막 날 자산가치 최댓값: %.2f\n', max_final);

%(d)
prob_loss = mean(final_assets < 100)*100

%(e)
rand_indices = randperm(num_paths, 30);

figure(7);
plot(0:days, asset_paths(rand_indices, :)', 'LineWidth', 1.2);
grid on; 
