clear; clc;

%(a)
rng(13);

%(b)
p_i = 0.35 + (0.95 - 0.35) * rand(1, 40);

%(c)
num_students = 5000;
num_questions = 40;
rand_matrix = rand(num_students, num_questions);
correct_matrix = rand_matrix <= p_i;

%(d)
total_scores = sum(correct_matrix, 2);
mean_scores = mean(correct_matrix, 2);
std_scores = std(double(correct_matrix), 0, 2);

%(e)
overall_mean_score = mean(total_scores);
above_mean_ratio = mean(total_scores >= overall_mean_score);


disp(above_mean_ratio * 100);

histogram(total_scores, 'BinWidth', 1, 'FaceColor', 'b', 'EdgeColor', 'k');
hold on;
xline(overall_mean_score, 'r--', 'LineWidth', 2);
hold off;
grid on; box on;

legend('점수 분포', sprintf('평균점수: %.2f점', overall_mean_score));
