clear; clc;

num_days = 10000;

%(a)
server_variance = 35 * randn(num_days, 1);

%(b)
cooling_overload = rand(num_days, 1) <= 0.12;

%(c)
base_load = 500;
total_power = base_load + server_variance + (cooling_overload * 120);

%(d)
over_650_ratio = mean(total_power > 650);

%(e)
mean_overload = mean(total_power(cooling_overload == 1));
mean_normal = mean(total_power(cooling_overload == 0));

fprintf('전력 사용량 650 초과 일수 비율: %.2f%%\n', over_650_ratio * 100);
fprintf('냉각장치 과부하 발생 시 평균 전력 사용량: %.2f\n', mean_overload);
fprintf('냉각장치 정상 가동 시 평균 전력 사용량: %.2f\n\n', mean_normal);

figure(11);
histogram(total_power, 'FaceColor', [0.7 0.2 0.2], 'EdgeColor', 'k');
hold on;
xline(650, 'y--', 'LineWidth', 2);
hold off;
grid on; box on;
xlabel('하루 전력 사용량');
ylabel('일수 (Days)');
title('10,000일간의 전력 사용량 분포 (10번)');
legend('전력 사용량', '임계 기준선 (650)');
